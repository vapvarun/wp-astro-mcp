{
  "name": "wp-astro-mcp",
  "version": "3.3.0",
  "description": "Headless WordPress MCP server — adds an Astro frontend layer to WordPress sites with multi-site support and GitHub publishing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc",
    "build:low-mem": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc --incremental",
    "start": "node dist/index.js",
    "dev": "npx tsc --watch",
    "setup": "npm install && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.0.0",
    "he": "^1.2.0",
    "isomorphic-dompurify": "^3.18.0",
    "sanitize-filename": "^1.6.3",
    "simple-git": "^3.27.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/he": "^1.2.3",
    "@types/node": "^20.19.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
